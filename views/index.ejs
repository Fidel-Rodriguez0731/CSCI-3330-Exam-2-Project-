<%- include('partials/header') %>

<main class="site-main">

  <!-- Homepage Hero Section -->
  <section class="home-hero">

    <div class="hero-copy">
      <span class="eyebrow">Welcome to PawFinder 🐾</span>

      <h1>Every pet deserves <em>a loving home.</em></h1>

      <p>
        Meet some wonderful dogs and cats waiting for their next chapter.
        Your new best friend might be just a click away (fr just click).
      </p>

      <div class="hero-buttons">
        <a class="btn btn-primary" href="/pets">
          Meet Our Pets <span aria-hidden="true">→</span>
        </a>

        <a class="btn btn-secondary" href="/appointments">
          Schedule a Visit
        </a>
      </div>

      <div class="hero-note">
        <span>♥</span> A little love makes a big difference.
      </div>
    </div>

    <!-- Hero Image -->
    <div class="hero-image-wrap">
      <img class="hero-image" src="/images/pets/1.jpg" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1693615775129-f2004d6e3e0b?auto=format&fit=crop&w=900&q=82'" alt="Friendly golden retriever" fetchpriority="high">

      <span class="hero-tag">Say hello to your new best friend!</span>
    </div>

  </section>


  <!-- How Adoption Works -->
  <section class="home-section" aria-labelledby="steps-title">

    <div class="section-heading">
      <span class="eyebrow">Simple & welcoming</span>
      <h2 id="steps-title">How adoption works</h2>
      <p>Three easy steps to getting to know your future companion.</p>
    </div>

    <div class="steps-grid">

      <!-- Step 1 -->
      <article class="step-card">
        <span class="step-icon">🐶</span>
        <span class="step-number">01</span>

        <h3>Find a friend</h3>
        <p>Browse available pets and find one you connect with.</p>
      </article>

      <!-- Step 2 -->
      <article class="step-card">
        <span class="step-icon">📅</span>
        <span class="step-number">02</span>

        <h3>Plan a visit</h3>
        <p>Pick a shelter and schedule a time to meet your favorite pet.</p>
      </article>

      <!-- Step 3 -->
      <article class="step-card">
        <span class="step-icon">🏡</span>
        <span class="step-number">03</span>

        <h3>Apply to adopt</h3>
        <p>Send an application and let our staff guide you through the next step.</p>
      </article>

    </div>
  </section>


  <!-- Shelter Information Section -->
  <section class="feature-strip">

    <div>
      <span class="eyebrow">Made with care</span>
      <h2>Big hearts. Little paws.</h2>

      <p>
        At PawFinder, we help connect loving people with pets looking for
        a home across our three Rio Grande Valley locations.
      </p>

      <a class="text-link" href="/locations">
        Explore our locations →
      </a>
    </div>

    <div class="feature-icons" aria-hidden="true">
      <span>🐈</span>
      <span>🐕</span>
      <span>💚</span>
    </div>

  </section>

</main>

<%- include('partials/footer') %>