<%- include('partials/header') %>

<main class="site-main">

  <!-- Shelter Objects -->
  <%
        const mission = shelters.find(s => s.shelterId === 1);
        const edinburg = shelters.find(s => s.shelterId === 2);
        const mcallen = shelters.find(s => s.shelterId === 3);
    %>

  <!-- Page Introduction -->
  <div class="page-intro">
    <span class="eyebrow">Come say hello</span>
    <h1>Our shelter locations</h1>
    <p>Visit one of our three Rio Grande Valley locations and get to know the pets in our care.</p>
  </div>

  <!-- Shelter Locations -->
  <section class="locations-grid">

    <!-- Mission Branch -->
    <article class="location-card">

      <div class="location-top">
        <span class="location-symbol">🏡</span>

        <span class="location-count">
          <%= mission.availablePets.length %> available pets
        </span>
      </div>

      <h2><%= mission.name %></h2>

      <p>📍 123 Rescue Way, Mission, TX 78572</p>
      <p>🕒 Mon–Sat · 9:00 AM – 5:00 PM</p>
      <p>☎ (956) 555-0199</p>

      <a href="/appointments?location=Mission" class="btn btn-primary">
        Visit Mission →
      </a>

    </article>

    <!-- Edinburg Branch -->
    <article class="location-card">

      <div class="location-top">
        <span class="location-symbol">🏡</span>

        <span class="location-count">
          <%= edinburg.availablePets.length %> available pets
        </span>
      </div>

      <h2><%= edinburg.name %></h2>

      <p>📍 456 Adoption Blvd, Edinburg, TX 78539</p>
      <p>🕒 Mon–Sat · 9:00 AM – 5:00 PM</p>
      <p>☎ (956) 555-0144</p>

      <a href="/appointments?location=Edinburg" class="btn btn-primary">
        Visit Edinburg →
      </a>

    </article>

    <!-- McAllen Branch -->
    <article class="location-card">

      <div class="location-top">
        <span class="location-symbol">🏡</span>

        <span class="location-count">
          <%= mcallen.availablePets.length %> available pets
        </span>
      </div>

      <h2><%= mcallen.name %></h2>

      <p>📍 789 Paw Street, McAllen, TX 78501</p>
      <p>🕒 Mon–Sat · 9:00 AM – 5:00 PM</p>
      <p>☎ (956) 123-4567</p>

      <a href="/appointments?location=McAllen" class="btn btn-primary">
        Visit McAllen →
      </a>

    </article>

  </section>

  <!-- Sample Contact Information Notice -->
  <div class="small-note">
    Shelter contact details are sample details used for this class project.
  </div>

</main>

<%- include('partials/footer') %>