<%- include('partials/header') %>

<main class="site-main dashboard-page">

  <!-- Staff Dashboard Header -->
  <div class="dashboard-head">
    <div>
      <span class="eyebrow">Shelter management</span>
      <h1>Staff dashboard</h1>
      <p>Review adoption applications and manage upcoming visits.</p>
    </div>

    <form action="/logout" method="POST" class="logout-form">
      <button class="btn btn-secondary" type="submit">Logout</button>
    </form>
  </div>

  <!-- Adoption Applications -->
  <section class="dashboard-section">
    <div class="dashboard-section-head">
      <div>
        <h2>Adoption applications</h2>
        <p>Review requests from potential adopters.</p>
      </div>

      <span class="count-chip"><%= applications.length %> total</span>
    </div>

    <% if (applications.length === 0) { %>
    <div class="dashboard-empty">
      🐾
      <strong>No applications yet.</strong>
      <span>New adoption requests will appear here.</span>
    </div>
    <% } else { %>

    <div class="table-scroll">
      <table class="dashboard-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Applicant</th>
            <th>Email</th>
            <th>Pet</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% applications.forEach(application => { %>
          <tr>
            <td>#<%= application.applicationId %></td>
            <td><%= application.applicantName %></td>
            <td><%= application.applicantEmail %></td>
            <td><%= application.petName %></td>

            <td>
              <span class="status-chip status-<%= String(application.status).toLowerCase() %>">
                <%= application.status %>
              </span>
            </td>

            <td>
              <div class="action-group">

                <!-- Approve Application -->
                <form action="/staff/applications/status" method="POST">
                  <input type="hidden" name="applicationId" value="<%= application.applicationId %>">
                  <input type="hidden" name="status" value="Approved">
                  <button class="action-btn action-approve" type="submit">Approve</button>
                </form>

                <!-- Reject Application -->
                <form action="/staff/applications/status" method="POST">
                  <input type="hidden" name="applicationId" value="<%= application.applicationId %>">
                  <input type="hidden" name="status" value="Rejected">
                  <button class="action-btn action-reject" type="submit">Reject</button>
                </form>

              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% } %>
  </section>

  <!-- Scheduled Appointments -->
  <section class="dashboard-section">
    <div class="dashboard-section-head">
      <div>
        <h2>Scheduled appointments</h2>
        <p>Confirm or cancel requested visits.</p>
      </div>

      <span class="count-chip"><%= appointments.length %> total</span>
    </div>

    <% if (appointments.length === 0) { %>
    <div class="dashboard-empty">
      📅
      <strong>No appointments yet.</strong>
      <span>New visit requests will appear here.</span>
    </div>
    <% } else { %>

    <div class="table-scroll">
      <table class="dashboard-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Pet</th>
            <th>Date</th>
            <th>Location</th>
            <th>Notes</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% appointments.forEach(appointment => { %>
          <tr>
            <td>#<%= appointment.appointmentId %></td>
            <td><%= appointment.name %></td>
            <td><%= appointment.email %></td>
            <td><%= appointment.petName %></td>
            <td><%= appointment.appointmentDate %></td>
            <td><%= appointment.location %></td>
            <td><%= appointment.notes || '—' %></td>

            <td>
              <span class="status-chip status-<%= String(appointment.status).toLowerCase() %>">
                <%= appointment.status %>
              </span>
            </td>

            <td>
              <div class="action-group">

                <!-- Confirm Appointment -->
                <form action="/staff/appointments/status" method="POST">
                  <input type="hidden" name="appointmentId" value="<%= appointment.appointmentId %>">
                  <input type="hidden" name="status" value="Confirmed">
                  <button class="action-btn action-approve" type="submit">Confirm</button>
                </form>

                <!-- Cancel Appointment -->
                <form action="/staff/appointments/status" method="POST">
                  <input type="hidden" name="appointmentId" value="<%= appointment.appointmentId %>">
                  <input type="hidden" name="status" value="Cancelled">
                  <button class="action-btn action-reject" type="submit">Cancel</button>
                </form>

              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% } %>
  </section>

</main>

<%- include('partials/footer') %>