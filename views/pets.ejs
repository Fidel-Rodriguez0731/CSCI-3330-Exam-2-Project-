<%- include('partials/header') %>

<main>
    <h2>Available Pets</h2>
    <p>Meet our pets looking for a loving home!</p>

    
<form action="/pets" method="GET">
    <label for="type">Filter by animal type:</label>

    <select name="type" id="type">
        <option value="All" <%= selectedType === 'All' ? 'selected' : '' %>>
            All Pets
        </option>
        <option value="Dog" <%= selectedType === 'Dog' ? 'selected' : '' %>>
            Dogs
        </option>
        <option value="Cat" <%= selectedType === 'Cat' ? 'selected' : '' %>>
            Cats
        </option>
    </select>

    <button type="submit">Filter</button>
</form>


    <section id="pet-list">
        <% pets.forEach(pet => { %>
            <div class="pet-card">
                <h3><%= pet.name %></h3>
                <p>Type: <%= pet.type %></p>
                <p>Breed: <%= pet.breed %></p>
                <p>Age: <%= pet.age %> years</p>
                <p>Status: <%= pet.status %></p>
            </div>
            <hr>
        <% }); %>
    </section>
</main>

<%- include('partials/footer') %>
