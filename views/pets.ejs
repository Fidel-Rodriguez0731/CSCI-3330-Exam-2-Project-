<%- include('partials/header') %>

<main class="site-main">

  <!-- Page Introduction -->
  <section class="page-intro">
    <span class="eyebrow">Find your favorite companion</span>
    <h1>Meet our pets</h1>
    <p>Every pet has a story. Explore our available animals and meet someone special.</p>
  </section>

  <!-- Pet Filtering Form -->
  <form action="/pets" method="GET" class="filter-form">

    <!-- Filter by Pet Type -->
    <div class="field">
      <label for="type">Pet type</label>

      <select name="type" id="type">
        <option value="All" <%= selectedType === 'All' ? 'selected' : '' %>>
          All animals
        </option>

        <option value="Dog" <%= selectedType === 'Dog' ? 'selected' : '' %>>
          Dogs
        </option>

        <option value="Cat" <%= selectedType === 'Cat' ? 'selected' : '' %>>
          Cats
        </option>
      </select>
    </div>

    <!-- Filter by Shelter Location -->
    <div class="field">
      <label for="location">Shelter location</label>

      <select name="location" id="location">
        <option value="" <%= !selectedLocation ? 'selected' : '' %>>
          All locations
        </option>

        <option value="Mission Branch" <%= selectedLocation === 'Mission Branch' ? 'selected' : '' %>>
          Mission
        </option>

        <option value="Edinburg Branch" <%= selectedLocation === 'Edinburg Branch' ? 'selected' : '' %>>
          Edinburg
        </option>

        <option value="McAllen Branch" <%= selectedLocation === 'McAllen Branch' ? 'selected' : '' %>>
          McAllen
        </option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary">
      Apply filters
    </button>
  </form>

  <!-- Available Pets Results -->
  <div class="results-heading">
    <h2>Available friends</h2>

    <span>
      <%= pets.length %> <%= pets.length === 1 ? 'pet' : 'pets' %> found
    </span>
  </div>

  <!-- Pet Cards -->
  <section class="pet-grid" id="pet-list">

    <% pets.forEach(pet => { %>

    <article class="pet-card">

      <!-- Pet Image -->
      <div class="pet-media">
        <img src="/images/pets/<%= pet.petId %>.jpg" onerror="this.onerror=null;this.src='<%= pet.image %>'" alt="Photo of <%= pet.name %>, a <%= pet.breed %>" loading="lazy">

        <span class="pet-available">
          <%= pet.status %>
        </span>
      </div>

      <!-- Pet Information -->
      <div class="pet-content">

        <div class="pet-title-row">
          <h3><%= pet.name %></h3>
          <span><%= pet.type %></span>
        </div>

        <p class="pet-breed">
          <%= pet.breed %> · <%= pet.age %>
          <%= pet.age === 1 ? 'year' : 'years' %> old
        </p>

        <p class="pet-location">
          📍 <%= pet.location %>
        </p>

        <!-- Schedule Visit Button -->
        <a class="btn btn-primary pet-visit" href="/appointments?location=<%= encodeURIComponent(pet.location) %>&petId=<%= pet.petId %>">
          Schedule a Visit →
        </a>

      </div>
    </article>

    <% }); %>

    <!-- No Pets Found -->
    <% if (pets.length === 0) { %>

    <div class="empty-state">
      <span>🐾</span>
      <h3>No pets match those filters</h3>
      <p>Try another location or animal type.</p>

      <a href="/pets" class="btn btn-secondary">
        View all pets
      </a>
    </div>

    <% } %>

  </section>

</main>

<%- include('partials/footer') %>