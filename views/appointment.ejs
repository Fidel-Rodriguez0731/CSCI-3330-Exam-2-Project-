<%- include('partials/header') %>

<div class="container mt-5">
    <h2>Schedule a Pet Visit / Appointment</h2>

    <form action="/appointments" method="POST" class="mt-3">

        <!-- Visitor Name -->
        <div class="mb-3">
            <label for="name" class="form-label">Your Name</label>
            <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                required
            >
        </div>

        <!-- Visitor Email -->
        <div class="mb-3">
            <label for="email" class="form-label">Your Email</label>
            <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
            >
        </div>

        <!-- Appointment Date -->
        <div class="mb-3">
            <label for="appointmentDate" class="form-label">
                Preferred Date & Time
            </label>
            <input
                type="datetime-local"
                class="form-control"
                id="appointmentDate"
                name="appointmentDate"
                required
            >
        </div>

        <!-- Shelter Location -->
        <div class="mb-3">
            <label for="location" class="form-label">
                Shelter Location
            </label>

            <select
                class="form-control"
                id="location"
                name="location"
                required
            >
                <option value="" disabled
                    <%= !selectedLocation ? 'selected' : '' %>>
                    Select a shelter location...
                </option>

                <option value="Mission Branch"
                    <%= selectedLocation === 'Mission' || selectedLocation === 'Mission Branch' ? 'selected' : '' %>>
                    Mission Branch
                </option>

                <option value="Edinburg Branch"
                    <%= selectedLocation === 'Edinburg' || selectedLocation === 'Edinburg Branch' ? 'selected' : '' %>>
                    Edinburg Branch
                </option>

                <option value="McAllen Branch"
                    <%= selectedLocation === 'McAllen' || selectedLocation === 'McAllen Branch' ? 'selected' : '' %>>
                    McAllen Branch
                </option>
            </select>
        </div>

        <!-- Available Pet Selection -->
        <div class="mb-3">
            <label for="petId" class="form-label">
                Select a Pet to Visit
            </label>

            <select
                class="form-control"
                id="petId"
                name="petId"
                required
            >
                <option value="" disabled
                    <%= !selectedPetId ? 'selected' : '' %>>
                    Select an available pet...
                </option>

                <% pets.forEach(pet => { %>
                    <option
                        value="<%= pet.petId %>"
                        data-location="<%= pet.location %>"
                        <%= String(pet.petId) === String(selectedPetId) ? 'selected' : '' %>
                    >
                        <%= pet.name %> - <%= pet.type %> (<%= pet.location %>)
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Additional Notes -->
        <div class="mb-3">
            <label for="notes" class="form-label">
                Additional Notes
            </label>

            <textarea
                class="form-control"
                id="notes"
                name="notes"
                rows="3"
                placeholder="Anything you'd like the shelter staff to know?"
            ></textarea>
        </div>

        <!-- Submit Appointment -->
        <button type="submit" class="btn btn-primary">
            Book Appointment
        </button>

    </form>
</div>

<!-- Filter pets by the selected shelter -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const locationSelect = document.getElementById('location');
    const petSelect = document.getElementById('petId');

    function filterPets() {
        const selectedLocation = locationSelect.value;

        Array.from(petSelect.options).forEach(option => {
            if (!option.value) return;

            const matchesLocation =
                option.dataset.location === selectedLocation;

            option.hidden = !matchesLocation;
            option.disabled = !matchesLocation;
        });

        const selectedOption = petSelect.selectedOptions[0];

        if (selectedOption && selectedOption.disabled) {
            petSelect.value = '';
        }
    }

    locationSelect.addEventListener('change', filterPets);

    filterPets();
});
</script>

<%- include('partials/footer') %>