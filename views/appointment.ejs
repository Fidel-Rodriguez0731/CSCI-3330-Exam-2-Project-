<%- include('partials/header') %>

<main class="site-main form-page">

  <!-- Page Introduction -->
  <div class="page-intro narrow">
    <span class="eyebrow">Get to know them</span>
    <h1>Schedule a pet visit</h1>
    <p>Choose a shelter, pick a pet, and let us know when you'd like to stop by.</p>
  </div>

  <div class="form-layout">

    <!-- Appointment Form -->
    <form action="/appointments" method="POST" class="form-card">
      <h2>Visit details</h2>
      <p class="form-hint">Choose a pet and a preferred date to request your visit.</p>

      <!-- Visitor Name -->
      <div class="field">
        <label for="name">Your name *</label>
        <input type="text" id="name" name="name" placeholder="First and last name" required>
      </div>

      <!-- Visitor Email -->
      <div class="field">
        <label for="email">Your email *</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>

      <!-- Appointment Date -->
      <div class="field">
        <label for="appointmentDate">Preferred date & time *</label>
        <input type="datetime-local" id="appointmentDate" name="appointmentDate" required>
      </div>

      <!-- Shelter Location -->
      <div class="field">
        <label for="location">Shelter location *</label>

        <select id="location" name="location" required>
          <option value="" disabled <%= !selectedLocation ? 'selected' : '' %>>
            Choose a shelter
          </option>

          <option value="Mission Branch" <%= selectedLocation === 'Mission' || selectedLocation === 'Mission Branch' ? 'selected' : '' %>>
            Mission Branch
          </option>

          <option value="Edinburg Branch" <%= selectedLocation === 'Edinburg' || selectedLocation === 'Edinburg Branch' ? 'selected' : '' %>>
            Edinburg Branch
          </option>

          <option value="McAllen Branch" <%= selectedLocation === 'McAllen' || selectedLocation === 'McAllen Branch' ? 'selected' : '' %>>
            McAllen Branch
          </option>
        </select>
      </div>

      <!-- Available Pet Selection -->
      <div class="field">
        <label for="petId">Pet you'd like to meet *</label>

        <select id="petId" name="petId" required>
          <option value="" disabled <%= !selectedPetId ? 'selected' : '' %>>
            Select a pet
          </option>

          <% pets.forEach(pet => { %>
          <option value="<%= pet.petId %>" data-location="<%= pet.location %>" <%= String(pet.petId) === String(selectedPetId) ? 'selected' : '' %>>
            <%= pet.name %> · <%= pet.breed %> (<%= pet.location %>)
          </option>
          <% }); %>
        </select>
      </div>

      <!-- Additional Notes -->
      <div class="field">
        <label for="notes">
          Additional notes <span class="optional">(optional)</span>
        </label>

        <textarea id="notes" name="notes" rows="4" placeholder="Anything you'd like our shelter staff to know?"></textarea>
      </div>

      <!-- Submit Appointment -->
      <button type="submit" class="btn btn-primary btn-full">
        Request Appointment →
      </button>

    </form>

    <!-- Appointment Information Card -->
    <aside class="help-card">
      <span class="help-emoji">📅</span>
      <h3>We can't wait to meet you.</h3>

      <p>
        Choose a pet at your selected shelter. Staff can confirm your
        requested visit from the dashboard.
      </p>

      <a class="text-link" href="/locations">
        See shelter locations →
      </a>
    </aside>

  </div>

</main>

<!-- Filter Pets Based on Selected Shelter -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const locationSelect = document.getElementById('location');
    const petSelect = document.getElementById('petId');

    function filterPets() {
      const location = locationSelect.value;

      Array.from(petSelect.options).forEach(option => {
        if (!option.value) return;

        const matched = option.dataset.location === location;

        option.hidden = !matched;
        option.disabled = !matched;
      });

      const current = petSelect.selectedOptions[0];

      if (current && current.disabled) {
        petSelect.value = '';
      }
    }

    locationSelect.addEventListener('change', filterPets);

    filterPets();
  });
</script>

<%- include('partials/footer') %>